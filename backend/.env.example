# Copy to backend/.env.
# Anything missing or broken falls back to its placeholder, so the app always starts.
# See what is actually running at http://localhost:8000/api/health

# ---- Which implementation each module uses ----
# Options = the keys of IMPLEMENTATIONS in app/modules/<module>/__init__.py
LIPREADING=mock
CORRECTION=passthrough
EMOTION=neutral
TTS=browser
TELEPHONY=disabled

# 1 = keep every uploaded clip in backend/data/recordings/ (test material for lip reading)
SAVE_RECORDINGS=0

# ---- Module-specific settings ----
# Each track adds the keys its module reads (API keys, model paths...) below,
# with an empty value. Real values only go in your own .env, never in this file.
